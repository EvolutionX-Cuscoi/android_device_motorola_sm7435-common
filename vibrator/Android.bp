cc_binary {
    name: "android.hardware.vibrator-service.moto_ldo",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.vibrator-service.moto_ldo.rc"],
    vintf_fragments: ["android.hardware.vibrator-service.moto_ldo.xml"],
    srcs: [
        "Vibrator.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "android.hardware.vibrator-V2-ndk",
    ],
}
